NODE_ENV=development
PORT=4000

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=phenomen_store
PG_POOL_MAX=10

PGAPPUSER=phenomen_app
PGAPPPASSWORD=replace_with_random_password

JWT_SECRET=replace_with_long_random_secret
JWT_EXPIRES_IN=30d

PLATFORM_JWT_SECRET=replace_with_long_random_secret
PLATFORM_JWT_EXPIRES_IN=12h
PLATFORM_ADMIN_LOGIN=km
PLATFORM_ADMIN_PASSWORD=replace_with_strong_password
PLATFORM_ADMIN_NAME=Главный администратор

DEMO_OWNER_LOGIN=km@phenomen.store
DEMO_OWNER_PASSWORD=replace_with_strong_password
DEMO_OWNER_NAME=Главный администратор

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PHENOMEN <no-reply@phenomen.store>

DEFAULT_TENANT_KEY=demo-fashion
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

VITE_API_URL=http://localhost:4000

EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_TENANT_KEY=demo-fashion
EXPO_PUBLIC_APP_NAME=PHENOMEN Store
