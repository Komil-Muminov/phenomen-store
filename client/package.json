{
  "name": "mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --host lan",
    "tunnel": "expo start --tunnel",
    "light": "expo start --host lan --no-dev --minify",
    "usb": "node -e \"const path=require('path');const tools=path.resolve(process.cwd(),'..','.tools','platform-tools');process.env.PATH=tools+path.delimiter+process.env.PATH;process.env.ANDROID_HOME=path.resolve(process.cwd(),'..','.tools');const r=require('child_process').spawnSync(process.execPath,[require.resolve('expo/bin/cli'),'start','--localhost'],{stdio:'inherit'});if(r.error)console.error(r.error.message)\"",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.51.1",
    "axios": "^1.7.2",
    "expo": "^54.0.36",
    "expo-constants": "~18.0.13",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "dotenv": "^16.4.5",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.9.2"
  }
}
